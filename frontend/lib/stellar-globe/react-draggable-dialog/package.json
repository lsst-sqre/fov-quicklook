{
  "name": "@stellar-globe/react-draggable-dialog",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist",
    "types"
  ],
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/react-draggable-dialog.es.js",
      "types": "./types/index.d.ts",
      "default": "./dist/react-draggable-dialog.es.es.js"
    },
    "./style.css": {
      "default": "./dist/react-draggable-dialog.css"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build --base=./",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "typed-scss-module": "typed-scss-modules src -n camel"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "classnames": "^2.5.1",
    "react-transition-group": "^4.4.5"
  },
  "peerDependencies": {
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/react-transition-group": "^4.4.11",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.16.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "sass": "^1.82.0",
    "typed-scss-modules": "^8.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-dts": "^4.3.0"
  }
}