    "components": {
        "schemas": {
            "CardType": {
                "prefixItems": [
                    {
                        "type": "string"
                    },
                    {
                        "type": "string"
                    },
                    {
                        "type": "string"
                    },
                    {
                        "type": "string"
                    }
                ],
                "type": "array",
                "maxItems": 4,
                "minItems": 4
            },
            "ContextMenuTemplate": {
                "properties": {
                    "name": {
                        "type": "string",
                        "title": "Name"
                    },
                    "template": {
                        "type": "string",
                        "title": "Template"
                    },
                    "is_url": {
                        "type": "boolean",
                        "title": "Is Url"
                    }
                },
                "type": "object",
                "required": [
                    "name",
                    "template",
                    "is_url"
                ],
                "title": "ContextMenuTemplate"
            },
            "CreateQuicklookRequest": {
                "properties": {
                    "visit": {
                        "type": "string",
                        "title": "Visit"
                    }
                },
                "type": "object",
                "required": [
                    "visit"
                ],
                "title": "CreateQuicklookRequest"
            },
            "DataSourceCcdMetadata": {
                "properties": {
                    "visit_name": {
                        "type": "string",
                        "title": "Visit Name"
                    },
                    "ccd_name": {
                        "type": "string",
                        "title": "Ccd Name"
                    },
                    "detector": {
                        "type": "integer",
                        "title": "Detector"
                    },
                    "exposure": {
                        "type": "integer",
                        "title": "Exposure"
                    },
                    "day_obs": {
                        "type": "integer",
                        "title": "Day Obs"
                    },
                    "uuid": {
                        "type": "string",
                        "title": "Uuid"
                    }
                },
                "type": "object",
                "required": [
                    "visit_name",
                    "ccd_name",
                    "detector",
                    "exposure",
                    "day_obs",
                    "uuid"
                ],
                "title": "DataSourceCcdMetadata"
            },
            "Entry": {
                "properties": {
                    "name": {
                        "type": "string",
                        "title": "Name"
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "directory",
                            "file"
                        ],
                        "title": "Type"
                    },
                    "size": {
                        "anyOf": [
                            {
                                "type": "integer"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Size"
                    }
                },
                "type": "object",
                "required": [
                    "name",
                    "type",
                    "size"
                ],
                "title": "Entry"
            },
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "HeaderType": {
                "items": {
                    "$ref": "#/components/schemas/CardType"
                },
                "type": "array"
            },
            "Job": {
                "properties": {
                    "visit": {
                        "type": "string",
                        "title": "Visit"
                    },
                    "id": {
                        "type": "string",
                        "title": "Id"
                    }
                },
                "type": "object",
                "required": [
                    "visit"
                ],
                "title": "Job"
            },
            "JobStatus": {
                "properties": {
                    "job": {
                        "$ref": "#/components/schemas/Job"
                    },
                    "stage": {
                        "type": "string",
                        "enum": [
                            "queued",
                            "generate_single_fits_tiles",
                            "merge_tiles",
                            "transfer_tiles",
                            "done"
                        ],
                        "title": "Stage",
                        "default": "queued"
                    },
                    "generate_single_fits_tiles": {
                        "additionalProperties": {
                            "$ref": "#/components/schemas/Progress"
                        },
                        "type": "object",
                        "title": "Generate Single Fits Tiles"
                    },
                    "merge_tiles": {
                        "additionalProperties": {
                            "$ref": "#/components/schemas/Progress"
                        },
                        "type": "object",
                        "title": "Merge Tiles"
                    },
                    "transfer_tiles": {
                        "additionalProperties": {
                            "$ref": "#/components/schemas/Progress"
                        },
                        "type": "object",
                        "title": "Transfer Tiles"
                    }
                },
                "type": "object",
                "required": [
                    "job"
                ],
                "title": "JobStatus"
            },
            "JobStatusList": {
                "additionalProperties": {
                    "$ref": "#/components/schemas/JobStatus"
                },
                "type": "object"
            },
            "Progress": {
                "properties": {
                    "total": {
                        "type": "integer",
                        "title": "Total"
                    },
                    "count": {
                        "type": "integer",
                        "title": "Count",
                        "default": 0
                    }
                },
                "type": "object",
                "required": [
                    "total"
                ],
                "title": "Progress"
            },
            "QuicklookMetadata": {
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Id"
                    },
                    "wcs": {
                        "additionalProperties": true,
                        "type": "object",
                        "title": "Wcs"
                    }
                },
                "type": "object",
                "required": [
                    "id",
                    "wcs"
                ],
                "title": "QuicklookMetadata"
            },
            "QuicklookStatus": {
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Id"
                    }
                },
                "type": "object",
                "required": [
                    "id"
                ],
                "title": "QuicklookStatus"
            },
            "SystemInfo": {
                "properties": {
                    "admin_page": {
                        "type": "boolean",
                        "title": "Admin Page"
                    },
                    "context_menu_templates": {
                        "items": {
                            "$ref": "#/components/schemas/ContextMenuTemplate"
                        },
                        "type": "array",
                        "title": "Context Menu Templates"
                    }
                },
                "type": "object",
                "required": [
                    "admin_page",
                    "context_menu_templates"
                ],
                "title": "SystemInfo"
            },
            "ValidationError": {
                "properties": {
                    "loc": {
                        "items": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "integer"
                                }
                            ]
                        },
                        "type": "array",
                        "title": "Location"
                    },
                    "msg": {
                        "type": "string",
                        "title": "Message"
                    },
                    "type": {
                        "type": "string",
                        "title": "Error Type"
                    }
                },
                "type": "object",
                "required": [
                    "loc",
                    "msg",
                    "type"
                ],
                "title": "ValidationError"
            },
            "VisitEntry": {
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Id"
                    },
                    "day_obs": {
                        "type": "integer",
                        "title": "Day Obs"
                    },
                    "physical_filter": {
                        "type": "string",
                        "title": "Physical Filter"
                    },
                    "obs_id": {
                        "type": "string",
                        "title": "Obs Id"
                    },
                    "exposure_time": {
                        "type": "number",
                        "title": "Exposure Time"
                    },
                    "science_program": {
                        "type": "string",
                        "title": "Science Program"
                    },
                    "observation_type": {
                        "type": "string",
                        "title": "Observation Type"
                    },
                    "observation_reason": {
                        "type": "string",
                        "title": "Observation Reason"
                    },
                    "target_name": {
                        "type": "string",
                        "title": "Target Name"
                    }
                },
                "type": "object",
                "required": [
                    "id",
                    "day_obs",
                    "physical_filter",
                    "obs_id",
                    "exposure_time",
                    "science_program",
                    "observation_type",
                    "observation_reason",
                    "target_name"
                ],
                "title": "VisitEntry"
            }
        }
    }
}
