        },
        "/api/storage": {
            "get": {
                "summary": "List Storage Entries",
                "operationId": "list_storage_entries",
                "parameters": [
                    {
                        "name": "path",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Path"
                        }
                    }
                ],
                "responses": {
