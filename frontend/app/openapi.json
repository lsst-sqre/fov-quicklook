        "/api/visits": {
            "get": {
                "summary": "List Visits",
                "operationId": "list_visits",
                "parameters": [
                    {
                        "name": "exposure",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "anyOf": [
                                {
                                    "type": "integer"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "title": "Exposure"
                        }
                    },
                    {
                        "name": "day_obs",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "anyOf": [
                                {
                                    "type": "integer"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "title": "Day Obs"
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "maximum": 10000,
                            "default": 1000,
                            "title": "Limit"
                        }
                    },
                    {
                        "name": "data_type",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "enum": [
                                "raw",
                                "post_isr_image",
                                "preliminary_visit_image"
                            ],
                            "type": "string",
                            "default": "raw",
                            "title": "Data Type"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/VisitEntry"
                                    },
                                    "title": "Response List Visits Api Visits Get"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
